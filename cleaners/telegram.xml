<?xml version="1.0" encoding="UTF-8"?>
<!--
SPDX-License-Identifier: GPL-3.0-or-later

Telegram Desktop cleaner.

Installed builds keep data in %APPDATA%\Telegram Desktop\tdata. Portable builds
keep "tdata" next to Telegram.exe and can live anywhere, so we also probe common
spots: the user's Downloads/Desktop/Documents and the roots of drives C/D/E/F.
Each account is a separate user_data, user_data#2, ... folder, hence user_data*.
Only the cache folders are touched (chat data and accounts are left intact).
For an unusual portable location, add a custom cleaner via the GUI.
-->
<cleaner id="telegram">
  <label>Telegram</label>
  <description>Instant messenger</description>
  <option id="cache">
    <label>Cache</label>
    <description>Delete the cache</description>
    <action command="delete" search="walk.all" path="%APPDATA%\Telegram Desktop\tdata\user_data*\cache"/>
    <action command="delete" search="walk.all" path="%USERPROFILE%\Downloads\Telegram*\tdata\user_data*\cache"/>
    <action command="delete" search="walk.all" path="%USERPROFILE%\Desktop\Telegram*\tdata\user_data*\cache"/>
    <action command="delete" search="walk.all" path="%USERPROFILE%\Documents\Telegram*\tdata\user_data*\cache"/>
    <action command="delete" search="walk.all" path="C:\Telegram*\tdata\user_data*\cache"/>
    <action command="delete" search="walk.all" path="D:\Telegram*\tdata\user_data*\cache"/>
    <action command="delete" search="walk.all" path="E:\Telegram*\tdata\user_data*\cache"/>
    <action command="delete" search="walk.all" path="F:\Telegram*\tdata\user_data*\cache"/>
  </option>
  <option id="media_cache">
    <label>Media cache</label>
    <description>Delete the cache</description>
    <action command="delete" search="walk.all" path="%APPDATA%\Telegram Desktop\tdata\user_data*\media_cache"/>
    <action command="delete" search="walk.all" path="%USERPROFILE%\Downloads\Telegram*\tdata\user_data*\media_cache"/>
    <action command="delete" search="walk.all" path="%USERPROFILE%\Desktop\Telegram*\tdata\user_data*\media_cache"/>
    <action command="delete" search="walk.all" path="%USERPROFILE%\Documents\Telegram*\tdata\user_data*\media_cache"/>
    <action command="delete" search="walk.all" path="C:\Telegram*\tdata\user_data*\media_cache"/>
    <action command="delete" search="walk.all" path="D:\Telegram*\tdata\user_data*\media_cache"/>
    <action command="delete" search="walk.all" path="E:\Telegram*\tdata\user_data*\media_cache"/>
    <action command="delete" search="walk.all" path="F:\Telegram*\tdata\user_data*\media_cache"/>
  </option>
</cleaner>
